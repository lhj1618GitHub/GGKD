{
    id: 1618,
    version: 3,
    name: 'test',
    author: 'lhj1618',
    checkUpdateUrl: 'https://gitee.com/lhj1618/GGKD/raw/master/.temp/new-app/version.json5',
    updateUrl: 'https://gitee.com/lhj1618/GGKD/raw/master/.temp/new-app/test.json5',
    supportUri: 'https://gitee.com/lhj1618/GGKD/tree/master/.temp/new-app',
    globalGroups: [],
    categories: [
        {
            key: 0,
            name: '自动化',
        },
        {
            key: 1,
            name: '弹窗广告',
        },
        {
            key: 2,
            name: '内嵌广告',
        },
    ],
    apps: [
        {
            id: 'com.phoenix.read',
            name: '红果免费短剧',
            groups: [
                {
                    key: 1,
                    name: '内嵌广告-剧集广告',
                    desc: '[back]',
                    rules: [
                        {
                            key: 0,
                            name: '广告预警',
                            action: 'back',
                            matches: [
                                '[vid="amo"]',
                            ],
                            actionDelay: 1000,
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.component.shortvideo.impl.ShortSeriesActivity',
                            ],
                        },
                        {
                            key: 1,
                            name: '观看完整剧集',
                            preKeys: [
                                0,
                            ],
                            matches: [
                                '[vid="ao4" || vid="eap"][visibleToUser=true]',
                            ],
                            fastQuery: true,
                        },
                        {
                            key: 2,
                            name: '从第一集开始观看-上滑',
                            preKeys: [
                                0,
                                1,
                            ],
                            action: 'swipe',
                            swipeArg: {
                                start: {
                                    x: '500',
                                    y: '1500',
                                },
                                end: {
                                    x: '500',
                                    y: '800',
                                },
                                duration: 200,
                            },
                            matches: [
                                '[vid="al"][visibleToUser=true]',
                            ],
                            actionDelay: 200,
                            fastQuery: true,
                        },
                    ],
                },
                {
                    key: 2,
                    name: '内嵌广告-看广告领金币',
                    desc: '领取完成[x]',
                    rules: [
                        {
                            matches: [
                                '@ViewGroup[width<393] <5 ViewGroup < FrameLayout < FrameLayout < FrameLayout < [vid="d2_"]',
                                '@ImageView[childCount=0] <n ViewGroup <5 ViewGroup < FrameLayout < FrameLayout < FrameLayout < [vid="d2_"]',
                            ],
                            matchRoot: true,
                            matchDelay: 5000,
                            fastQuery: true,
                            activityIds: [
                                'com.ss.android.excitingvideo.ExcitingVideoActivity',
                            ],
                        },
                    ],
                },
                {
                    key: 3,
                    name: '弹窗广告-宝箱相关',
                    desc: '领取/结算',
                    matchTime: 8000,
                    activityIds: [
                        'com.dragon.read.pages.main.MainFragmentActivity',
                    ],
                    rules: [
                        {
                            key: 1,
                            name: '开启宝箱',
                            position: {
                                left: 'width * 0.5',
                                top: 'width * 0.56',
                            },
                            matches: [
                                'ViewGroup[index=0][width=18][height=220][visibleToUser=true] < @ViewGroup < LinearLayout < HorizontalScrollView < ScrollView <3 FrameLayout < [vid="au5"]',
                            ],
                        },
                        {
                            key: 2,
                            name: '请选择宝箱奖励-左边',
                            preKeys: [
                                1,
                            ],
                            matches: [
                                '@ViewGroup < ViewGroup <3 FrameLayout < [vid="au5"]',
                            ],
                            fastQuery: true,
                        },
                        {
                            key: 3,
                            name: '关闭宝箱结算',
                            position: {
                                left: 'width * -3.6',
                                top: 'width * 8',
                            },
                            matches: [
                                '@ViewGroup[desc="第?个"][visibleToUser=true]',
                            ],
                        },
                    ],
                },
                {
                    key: 4,
                    name: '自动化-删除浏览历史',
                    desc: '点[确认]',
                    rules: [
                        {
                            matches: [
                                '[text="确定删除浏览历史吗？"]',
                                '[vid="clo"]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.pages.main.MainFragmentActivity',
                            ],
                        },
                    ],
                },
                {
                    key: 5,
                    name: '弹窗广告-金币',
                    desc: '点[X][取消][立即打卡]',
                    matchTime: 5000,
                    rules: [
                        {
                            key: 1,
                            name: '看短剧赚金币[x]',
                            matches: [
                                '[vid="title"][text="恭喜你获得"]',
                                '[vid="ean"]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.pages.main.MainFragmentActivity',
                            ],
                        },
                        {
                            key: 2,
                            name: '开启推送提醒-[取消]',
                            matches: [
                                '[text="开启推送提醒"]',
                                '[vid="cm_"]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.pages.main.MainFragmentActivity',
                            ],
                        },
                    ],
                },
            ],
        },
    ],
}