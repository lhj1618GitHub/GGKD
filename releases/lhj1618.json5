                                1,
                            ],
                            position: {
                                left: '0',
                                top: '-170',
                            },
                            matches: [
                                '@ImageView <4 FrameLayout <<6 LinearLayout < [parent=null]',
                            ],
                            fastQuery: true,
                        },
                    ],
                },
                {
                    key: 4,
                    name: '自动化-删除历史收藏不添加到桌面',
                    desc: '点[确认][删除][暂不添加]',
                    rules: [
                        {
                            matches: [
                                '[text="确认" || text="删除" || text="暂不添加"]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.pages.main.MainFragmentActivity',
                            ],
                        },
                    ],
                },
                {
                    key: 5,
                    name: '自动化-倍速播放',
                    desc: '[倍速][x1.5]',
                    matchTime: 3000,
                    rules: [
                        {
                            key: 0,
                            name: '点击倍速',
                            activityIds: 'com.dragon.read.component.shortvideo.impl.ShortSeriesActivity',
                            matches: '@TextView[visibleToUser=true][text!="1.5x"] <2 LinearLayout < FrameLayout',
                        },
                        {
                            key: 1,
                            name: '点击x1.5',
                            preKeys: [
                                0,
                            ],
                            activityIds: 'com.dragon.read.component.shortvideo.impl.ShortSeriesActivity',
                            matches: 'TextView[visibleToUser=true][text="1.5x"] < @ViewGroup <3 RecyclerView',
