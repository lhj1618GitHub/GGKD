                    rules: [
                        {
                            fastQuery: true,
                            activityIds: 'com.android.browser.BrowserActivity',
                            matches: 'TextView[text*="小部件"] <2 ViewGroup < FrameLayout < ViewGroup < ScrollView + LinearLayout > @Button[text="取消"]',
                        },
                    ],
                },
            ],
        },
        {
            id: 'com.android.permissioncontroller',
