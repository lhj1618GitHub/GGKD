                    ],
                },
                {
                    key: 5,
                    name: '自动化-红点标未读消息',
                    desc: '头像有红点',
                    rules: [
                        {
                            matches: [
                                '[vid="a_h"]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                '.ui.LauncherUI',
                            ],
                        },
                    ],
                },
                {
                    key: 6,
                    name: '自动化-操作确认',
                    desc: '点击[清空/删除]',
                    rules: [
                        {
                            key: 1,
                            name: '确认[清空]聊天记录',
                            matches: [
