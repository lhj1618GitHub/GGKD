                    ],
                    fastQuery: true,
                },
            ],
        },
        {
            key: 9,
            name: '弹窗广告-顶部金币图',
            desc: '[开心收下][我知道了]',
            actionMaximumKey: '1',
            rules: [
                {
                    key: 1,
                    name: '恭喜你已累计获得奖励[开心收下]',
