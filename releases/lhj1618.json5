        },
        {
    id: 'com.phoenix.read',
    name: '红果免费短剧',
    groups: [
        {
            key: 1,
            name: '内嵌广告-剧集广告',
            desc: '[back]/[退出观看]',
            fastQuery: true,
            activityIds: [
                'com.dragon.read.component.shortvideo.impl.ShortSeriesActivity',
            ],
            rules: [
                {
                    key: 1,
                    name: '广告预警时[返回]',
                    action: 'back',
                    matches: [
                        '[text*="广告" || vid="an1"]',
                    ],
                },
                {
                    key: 2,
                    name: '是否收藏本剧-[退出观看]',
                    preKeys: [
                        1,
                    ],
                    matches: [
                        '[vid="cm_"]',
                    ],
                },
                {
                    key: 3,
                    name: '推送提醒-点[取消]',
                    matches: [
                        '[vid="j3"][text="开启推送提醒"]',
                        '[vid="cm_"]',
                    ],
                },
            ],
        },
        {
            key: 2,
            name: '内嵌广告-看广告',
            desc: '领取完成[x]',
            rules: [
                {
                    matches: [
                        '@ViewGroup <5 ViewGroup < FrameLayout < FrameLayout < FrameLayout < [vid="d2_"]',
                        '@ImageView < ViewGroup <5 ViewGroup < FrameLayout < FrameLayout < FrameLayout < [vid="d2_"]',
                    ],
                    fastQuery: true,
                    matchDelay: 15000,
                    activityIds: [
                        'com.ss.android.excitingvideo.ExcitingVideoActivity',
                    ],
                },
            ],
        },
        {
            key: 3,
            name: '弹窗广告-宝箱相关',
            desc: '领取/结算',
            matchTime: 8000,
            activityIds: [
                'com.dragon.read.pages.main.MainFragmentActivity',
            ],
            rules: [
                {
                    key: 0,
                    name: '开启宝箱',
                    position: {
                        left: 'width * 0',
                        top: 'width * 0.56',
                    },
                    matches: [
                        '@ViewGroup[index=0][width=18][height=220][visibleToUser=true]',
                        '@ViewGroup < LinearLayout < HorizontalScrollView < ScrollView <3 FrameLayout < [vid="au5"]',
                    ],
                },
                {
                    key: 1,
                    name: '关闭宝箱结算',
                    position: {
                        left: 'width * -3.6',
                        top: 'width * 8',
                    },
                    matches: [
                        '@ViewGroup[desc="第?个"][visibleToUser=true]',
                    ],
                },
            ],
        },
        {
            key: 4,
            name: '自动化-删除浏览历史',
            desc: '点[确认]',
            rules: [
                {
                    matches: [
                        '[text="确定删除浏览历史吗？"]',
                        '[vid="clo"]',
                    ],
                    fastQuery: true,
                    activityIds: [
                        'com.dragon.read.pages.main.MainFragmentActivity',
                    ],
                },
            ],
        },
        {
            key: 5,
            name: '弹窗广告-签到',
            desc: '[立即领取][x]',
            rules: [
                {
                    key: 1,
                    name: '[立即领取]',
                    matches: [
                        '@ViewGroup[width>272] < ViewGroup < ViewGroup < FrameLayout < [vid="au5"]',
                    ],
                    fastQuery: true,
                    actionMaximum: 1,
                    activityIds: [
                        'com.dragon.read.pages.main.MainFragmentActivity',
                    ],
                },
                {
                    key: 2,
                    name: '签到下一轮可领[x]',
                    position: {
                        left: '552',
                        top: '1830',
                    },
                    matches: [
                        '@ViewGroup[width=310] <4 ViewGroup < ViewGroup < FrameLayout < [vid="au5"]',
                    ],
                    fastQuery: true,
                },
            ],
        },
        {
            key: 6,
            name: '弹窗广告-今日签到可领',
            desc: '[立即签到]',
            rules: [
                {
                    position: {
                        left: 'width * 1.5625',
                        top: 'width * 2.8493',
                    },
                    matches: [
                        '@ViewGroup[width=272] < ViewGroup < ViewGroup < FrameLayout < [vid="au5"]',
                    ],
                    fastQuery: true,
                    activityIds: [
