        {
            id: 'com.phoenix.read',
            name: '红果免费短剧',
            groups: [
                {
                    key: 1,
                    name: '弹窗广告-宝箱相关',
                    desc: '开启/领取/关闭',
                    matchTime: 10000,
                    rules: [
                        {
                            key: 1,
                            name: '开启宝箱',
                            actionMaximum: 1,
                            position: {
                                left: 'width * 0.5',
                                top: 'width * 0.56',
                            },
                            activityIds: 'com.dragon.read.pages.main.MainFragmentActivity',
                            matches: [
                                'ViewGroup[index=0][width=18][height=220][visibleToUser=true] < @ViewGroup <<3 ScrollView - ScrollView <<23 [parent=null]',
                            ],
                        },
                        {
                            key: 2,
                            name: '选择宝箱奖励_左侧',
                            preKeys: [
                                1,
