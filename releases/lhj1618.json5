                    ],
                },
                {
                    key: 3,
                    name: '自动化-定位权限',
                    actionMaximum: 1,
                    resetMatch: 'app',
                    rules: [
                        {
                            matches: [
                                '[text^="位置权限" || text$="定位权限"]',
                                '[text="取消"][clickable=true]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.mc10086.cmcc.view.tabs.AppTabFragment',
                            ],
                        },
                    ],
                },
            ],
        },
