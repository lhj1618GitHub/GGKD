        {
            id: 'com.android.browser',
            name: '浏览器',
            groups: [
                {
                    key: 1,
                    name: '弹窗广告-关闭[个性推荐开启提示]',
                    matchTime: 5000,
                    activityIds: [
                        'com.android.browser.BrowserActivity',
