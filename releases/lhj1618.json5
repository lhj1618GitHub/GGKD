                    key: 5,
                    name: '自动化-通知权限',
                    desc: '点击[x]和返回键',
                    fastQuery: true,
                    actionMaximum: 1,
                    matchTime: 5000,
                    resetMatch: 'app',
                    rules: [
                        {
                            key: 0,
                            matches: [
