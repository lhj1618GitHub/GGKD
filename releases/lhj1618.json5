                    ],
                },
                {
                    key: 4,
                    name: '弹窗广告-下单后出现的弹窗',
                    desc: '点击[x]',
                    fastQuery: true,
                    matchTime: 5000,
                    rules: [
                        {
                            key: 0,
                            action: 'clickCenter',
                            matches: [
                                'Button[text="关闭弹窗" || desc="关闭弹窗"][clickable=true]',
