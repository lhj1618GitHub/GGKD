        {
            id: 'com.xunmeng.pinduoduo',
            name: '拼多多',
            groups: [
                {
                    key: 1,
                    name: '弹窗广告-多关键词',
                    desc: '使用[返回键]和点击[x]',
                    fastQuery: true,
                    matchTime: 5000,
                    rules: [
                        {
                            key: 0,
                            action: 'back',
                            matches: [
                                '[text="开心收下" || text="去抢购" || text="立即抽免单" || text="去刮奖" || text="立即领取" || text="去领大额金币" || text="送你大额现金" || text*="红包助手" || text="刮刮卡发来的消息通知" || text="立即充值" || text="打款金额"][top>600][visibleToUser=true]',
