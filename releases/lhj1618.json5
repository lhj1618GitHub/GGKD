        {
            id: 'com.xiaomi.market',
            name: '应用商店',
            groups: [
                {
                    key: 1,
                    name: '自动化-查看全部升级',
                    desc: '[查看全部]',
                    rules: [
                        {
                            fastQuery: true,
                            activityIds: 'com.xiaomi.market.ui.UpdateListActivity',
                            matches: '[vid="fold_text"] < @LinearLayout <5 [id="android:id/list"]',
                        },
                    ],
                },
                {
                    key: 2,
                    name: '自动化-展开应用升级',
                    desc: '[展开]',
                    rules: [
                        {
                            fastQuery: true,
                            activityIds: [
                                'com.xiaomi.market.ui.UpdateListActivity',
