                    key: 2,
                    name: '自动化-剪贴板权限弹窗',
                    desc: '点击不允许',
                    fastQuery: true,
                    actionMaximum: 1,
                    matchTime: 5000,
                    resetMatch: 'app',
                    activityIds: [
                        'com.mc10086.cmcc.view.tabs.AppTabFragment',
                        'com.mc10086.cmcc.base.StartPageActivity',
                    ],
                    rules: [
                        {
