                    fastQuery: true,
                    activityIds: [
                        'com.android.browser.BrowserActivity',
                        'com.android.browser.flow.view.FeedbackDialog',
                    ],
                    rules: [
                        {
                            key: 0,
                            matches: [
                                '@[id!=null][desc="负反馈"][visibleToUser=true] -n * > * > [text="广告"]',
