                            fastQuery: true,
                            activityIds: 'com.tencent.mm.framework.app.UIPageFragmentActivity',
                            matches: '[vid="kinda_button_impl_wrapper"][desc="完成" || desc="返回商家"]',
                        },
                    ],
                },
                {
                    key: 3,
                    name: '自动化-自动语音转文字',
                    desc: '语音旁边的[转文字]',
                    rules: [
                        {
                            matches: '[text="转文字" || vid="c1i"][vid!="obc"][vid!="rsf"]',
