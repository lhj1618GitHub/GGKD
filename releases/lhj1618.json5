                            matches: '@ViewGroup < ViewGroup -2 ViewGroup[top=700] <<11 [parent=null]',
                        },
                        {
                            key: 3,
                            name: '关闭宝箱结算',
                            position: {
                                left: 'width * -3.6',
                                top: 'width * 8',
                            },
                            activityIds: 'com.dragon.read.pages.main.MainFragmentActivity',
                            matches: [
                                '@ViewGroup[desc="第?个"][visibleToUser=true]',
                            ],
                        },
                        {
                            key: 4,
                            name: '关闭重复结算',
                            position: {
                                x: 540,
                                y: 1650,
                            },
                            activityIds: 'com.dragon.read.pages.main.MainFragmentActivity',
                            matches: [
                                '@ViewGroup < ViewGroup -2 ViewGroup[top!=700] <<11 [parent=null]',
                            ],
                        },
                    ],
                },
                {
                    key: 2,
                    name: '内嵌广告-剧集广告',
                    desc: '[back][观看完整剧集]跳过重复',
                    rules: [
                        {
                            key: 0,
                            name: '片首片尾广告预警',
                            action: 'back',
                            anyMatches: [
                                'FrameLayout[childCount=1] <3 RecyclerView < [vid="l0"]',
                                '[text*="进入广告"][visibleToUser=true]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.component.shortvideo.impl.ShortSeriesActivity',
                            ],
                        },
                        {
                            key: 1,
                            name: '观看完整剧集/历史和收藏',
                            preKeys: [
                                0,
                            ],
                            anyMatches: [
                                'FrameLayout[clickable=true][focusable=true][visibleToUser=true][width=1080]',
                                'ViewGroup[index=0][longClickable=true][visibleToUser=true]',
                            ],
                            fastQuery: true,
                            activityIds: [
                                'com.dragon.read.pages.main.MainFragmentActivity',
                            ],
                        },
                    ],
                },
                {
                    key: 3,
                    name: '内嵌广告-看广告领金币',
                    desc: '领取完成[x][坚持退出]',
                    rules: [
                        {
                            key: 1,
                            name: '倒计时结束-领取完成',
                            action: 'back',
                            matches: [
                                '@ViewGroup[width=246][visibleToUser=true] <5 ViewGroup < FrameLayout < FrameLayout < FrameLayout < FrameLayout < FrameLayout < FrameLayout < LinearLayout < [parent=null]',
                            ],
                            fastQuery: true,
                            matchRoot: true,
                            matchDelay: 15000,
                            activityIds: [
                                'com.ss.android.excitingvideo.ExcitingVideoActivity',
